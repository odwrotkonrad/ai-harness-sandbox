##[>] 🤖🤖
ARG INSTALLS_IMAGE=localhost:5001/sandbox-installs:local
FROM ${INSTALLS_IMAGE}

ARG SANDBOX_USER=ko

COPY ci/docker/merge-claude-onboarding.py /usr/local/bin/merge-claude-onboarding.py

ARG CONFIGS_REF=main
#[why] build secrets do not invalidate the layer cache, so a rebuild after a credential changed
#   would silently reuse the layer built without it. this digest of the mounted secrets changes
#   whenever any of them does, which is what actually busts the cache
ARG SECRETS_DIGEST=none
RUN --mount=type=secret,id=claude_credentials,uid=1000,required=false \
    --mount=type=secret,id=claude_onboarding,uid=1000,required=false \
    --mount=type=secret,id=gcp_sa_key,uid=1000,required=false \
    --mount=type=secret,id=gitlab_token,uid=1000,required=false \
    set -eux; \
    : "${CONFIGS_REF}" "${SECRETS_DIGEST}"; \
    export CI=1 container=podman CHE_OTEL_ENABLED=false CHE_VALIDATE_SPEC=error CHE_ERREXIT=true; \
    export CHE_RENDER_TEMPLATES_SKIP_SECRETS=true; \
    export GITLAB_TOKEN="$(cat /run/secrets/gitlab_token 2>/dev/null || true)"; \
    configs=/home/$SANDBOX_USER/.cache/che/remote-sources/gitlab.com-konradodwrot-configs; \
    [ -d "$configs" ] || git clone --quiet https://gitlab.com/konradodwrot/configs.git "$configs"; \
    (cd "$configs" && che run --profiles ontoRepo); \
    cd /home/$SANDBOX_USER/.sandbox-che; \
    che run --profiles sandbox-image --skip-ops install-packages; \
    #[why] both paths until the configs change that exports CLAUDE_CONFIG_DIR from zshenv is
    #   released: the image clones configs from the remote, so a build can pull a profile that sets
    #   the variable for interactive shells only. writing one path leaves the other kind of shell
    #   reading an empty dir. drop ~/.claude once the released profile sets it for every shell
    if [ -s /run/secrets/claude_credentials ]; then \
      mkdir -p "/home/$SANDBOX_USER/.claude" "/home/$SANDBOX_USER/.config/claude"; \
      install -m 0600 /run/secrets/claude_credentials "/home/$SANDBOX_USER/.claude/.credentials.json"; \
      install -m 0600 /run/secrets/claude_credentials "/home/$SANDBOX_USER/.config/claude/.credentials.json"; \
    fi; \
    #[why] a credential alone still leaves an interactive run at the theme picker and then the login
    #   screen: claude reads a profile with no onboarding state as a first run. merged rather than
    #   written, so whatever the config layer already put in .claude.json survives
    if [ -s /run/secrets/claude_onboarding ]; then \
      for dir in "/home/$SANDBOX_USER/.claude" "/home/$SANDBOX_USER/.config/claude"; do \
        python3 /usr/local/bin/merge-claude-onboarding.py "$dir/.claude.json" /run/secrets/claude_onboarding; \
        chmod 600 "$dir/.claude.json"; \
      done; \
    fi; \
    if [ -s /run/secrets/gcp_sa_key ]; then \
      mkdir -p "/home/$SANDBOX_USER/.config/gcloud"; \
      install -m 0600 /run/secrets/gcp_sa_key "/home/$SANDBOX_USER/.config/gcloud/sandbox-sa.json"; \
    fi; \
    for cfg in $(find "/home/$SANDBOX_USER/projects" -path '*/.git/config'); do \
      repo="${cfg%/.git/config}"; \
      url="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"; \
      case "$url" in \
        *@gitlab.com/*) git -C "$repo" remote set-url origin "https://gitlab.com/${url#*@gitlab.com/}" ;; \
      esac; \
    done; \
    if grep -rq 'glpat-' "/home/$SANDBOX_USER/projects" --include=config; then \
      echo "the gitlab token survived in a git remote; refusing to bake it into the image" >&2; \
      exit 1; \
    fi
##[<] 🤖🤖
